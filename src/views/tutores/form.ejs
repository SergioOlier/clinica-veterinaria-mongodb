<%- include('../partials/header') %>

<section class="panel">
  <div class="panel-head">
    <h2><%= modo === 'nuevo' ? 'Registrar tutor' : 'Editar tutor' %></h2>
    <a class="btn ghost" href="/tutores">← Volver</a>
  </div>
  <div class="panel-body">
    <% if (errores.length) { %>
      <div class="alert danger">
        <strong>Revise los siguientes campos:</strong>
        <ul><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul>
      </div>
    <% } %>

    <form method="post" action="<%= modo === 'nuevo' ? '/tutores' : `/tutores/${tutor._id}/actualizar` %>">
      <div class="form-grid">
        <div class="campo"><label for="nombre">Nombre *</label><input id="nombre" name="nombre" value="<%= valores.nombre %>" required></div>
        <div class="campo"><label for="apellido">Apellido *</label><input id="apellido" name="apellido" value="<%= valores.apellido %>" required></div>
        <div class="campo"><label for="documento">Documento *</label><input id="documento" name="documento" value="<%= valores.documento %>" placeholder="Ej. 1012345678" required></div>
        <div class="campo"><label for="telefono">Teléfono *</label><input id="telefono" name="telefono" value="<%= valores.telefono %>" placeholder="Ej. 3001234567" required></div>
        <div class="campo full"><label for="email">Correo electrónico *</label><input id="email" name="email" type="email" value="<%= valores.email %>" required></div>

        <div class="campo full"><label for="calle">Dirección (documento embebido)</label><input id="calle" name="calle" value="<%= valores.direccion.calle %>" placeholder="Calle, carrera, número" required></div>
        <div class="campo"><label for="ciudad">Ciudad *</label><input id="ciudad" name="ciudad" value="<%= valores.direccion.ciudad %>" required></div>
        <div class="campo"><label for="codigoPostal">Código postal *</label><input id="codigoPostal" name="codigoPostal" value="<%= valores.direccion.codigoPostal %>" required></div>
      </div>

      <div class="form-actions">
        <a class="btn ghost" href="/tutores">Cancelar</a>
        <button class="btn primary" type="submit"><%= modo === 'nuevo' ? 'Guardar tutor' : 'Actualizar tutor' %></button>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
