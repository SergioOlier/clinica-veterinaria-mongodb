<%- include('../partials/header') %>

<div class="cards">
  <div class="card"><h3>Pacientes asociados</h3><div class="valor"><%= pacientes.length %></div></div>
  <div class="card"><h3>Citas acumuladas</h3><div class="valor"><%= totalCitas %></div></div>
</div>

<section class="panel">
  <div class="panel-head">
    <h2><%= tutor.nombre %> <%= tutor.apellido %></h2>
    <div class="nowrap">
      <a class="btn small ghost" href="/tutores/<%= tutor._id %>/editar">Editar</a>
      <form class="inline-form" method="post" action="/tutores/<%= tutor._id %>/eliminar" onsubmit="return confirm('¿Eliminar este tutor?');">
        <button class="btn small danger" type="submit">Eliminar</button>
      </form>
    </div>
  </div>
  <div class="panel-body">
    <dl class="detalle">
      <div><dt>Documento</dt><dd><%= tutor.documento %></dd></div>
      <div><dt>Teléfono</dt><dd><%= tutor.telefono %></dd></div>
      <div><dt>Correo</dt><dd><%= tutor.email %></dd></div>
      <div><dt>Ciudad</dt><dd><%= tutor.direccion.ciudad %></dd></div>
      <div><dt>Dirección</dt><dd><%= tutor.direccion.calle %> · CP <%= tutor.direccion.codigoPostal %></dd></div>
      <div><dt>Registrado</dt><dd><%= formatearFecha(tutor.createdAt) %></dd></div>
    </dl>
  </div>
</section>

<section class="panel">
  <div class="panel-head"><h2>Pacientes de este tutor</h2><a class="btn small primary" href="/pacientes/nuevo">+ Registrar paciente</a></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Nombre</th><th>Especie</th><th>Raza</th><th>Vacunas</th><th></th></tr></thead>
      <tbody>
        <% pacientes.forEach(p => { %>
          <tr>
            <td><a href="/pacientes/<%= p._id %>"><%= p.nombre %></a></td>
            <td><%= p.especie %></td>
            <td><%= p.raza %></td>
            <td><%= p.vacunas.length %></td>
            <td class="right"><a class="btn small ghost" href="/pacientes/<%= p._id %>">Ver historia</a></td>
          </tr>
        <% }) %>
        <% if (!pacientes.length) { %><tr><td colspan="5" class="vacio">Este tutor aún no tiene pacientes.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
